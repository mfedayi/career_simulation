// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Each user can:
// Write multiple reviews
// Leave multiple comments

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  username  String
  password  String
  reviews   Review[]  // array for reviews 
  comments  Comment[] // array for comments
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Item {
  id        String    @id @default(uuid())
  name      String
  description String
  reviews   Review[]  // array for reviews 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


// Each review is:
// Written by one User
// Belongs to one Item
// Can have multiple comments
// prisma
// Copy
// Edit

model Review {
  id        String   @id @default(uuid())
  text      String
  rating    Int      // maybe enforce 1-5 in validation
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  item      Item     @relation(fields: [itemId], references: [id])
  itemId    String
  comments  Comment[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId]) // enforce 1 review per item per user
}

// Each comment:
// Is written by a user
// Belongs to a review

model Comment {
  id        String   @id @default(uuid())
  text      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade) //delete review from comments array
  reviewId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}